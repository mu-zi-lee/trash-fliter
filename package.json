{
  "name": "trash-fliter",
  "version": "1.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "predev": "node -e \"import('./scripts/templates.mjs').then(m => m.buildTemplates())\"",
    "dev": "vite --host 127.0.0.1",
    "test": "node --test test/*.test.js",
    "check": "npm run test && npm run build",
    "test:browser": "node test/browser.mjs"
  },
  "devDependencies": {
    "htmlparser2": "^10.0.0",
    "@playwright/test": "^1.56.0",
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0",
    "vite": "^7.1.0"
  },
  "dependencies": {
    "lucide": "^0.468.0"
  }
}
